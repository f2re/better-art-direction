{
  "name": "better-art-direction-codex-skill",
  "version": "1.0.0",
  "description": "Codex-native art-direction skill with deterministic static and rendered UI checks.",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "npm run validate && npm test",
    "validate": "node scripts/validate-repo.mjs",
    "test": "node --test tests/*.test.mjs",
    "audit:self": "node skills/better-art-direction/scripts/static-audit.mjs tests/fixtures/clean-interface.html --strict",
    "audit:fixture": "node skills/better-art-direction/scripts/static-audit.mjs tests/fixtures/ai-slop.tsx --format markdown --no-fail"
  },
  "engines": {
    "node": ">=20"
  },
